<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" adaptive="false" time-dependent="false" xml:lang="nl-NL" identifier="ITEM006" title="Stappenplan">
  <qti-response-declaration identifier="RESPONSE" cardinality="ordered" base-type="identifier">
    <qti-correct-response>
      <qti-value>PV</qti-value><qti-value>OND</qti-value><qti-value>STAM</qti-value><qti-value>T</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" base-type="float" cardinality="single">
    <qti-default-value><qti-value>0</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="MAXSCORE" base-type="float" cardinality="single">
    <qti-default-value><qti-value>1</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="FEEDBACK" base-type="identifier" cardinality="single" />
  <qti-item-body>
    <qti-order-interaction response-identifier="RESPONSE" shuffle="true">
      <qti-prompt>Zet de stappen voor het spellen van de tegenwoordige tijd in de goede volgorde.</qti-prompt>
      <qti-simple-choice identifier="PV">Zoek de persoonsvorm.</qti-simple-choice>
      <qti-simple-choice identifier="OND">Zoek het onderwerp.</qti-simple-choice>
      <qti-simple-choice identifier="STAM">Bepaal de stam van het werkwoord.</qti-simple-choice>
      <qti-simple-choice identifier="T">Kijk of er een t achter de stam moet.</qti-simple-choice>
    </qti-order-interaction>
    <qti-feedback-block identifier="GOED" outcome-identifier="FEEDBACK" show-hide="show" class="qti-feedback-correct">
      <qti-content-body><p><strong>Goed zo!</strong> Met dit stappenplan spel je elke persoonsvorm in de tegenwoordige tijd goed.</p></qti-content-body>
    </qti-feedback-block>
    <qti-feedback-block identifier="HINT" outcome-identifier="FEEDBACK" show-hide="show" class="qti-feedback-hint">
      <qti-content-body><p><strong>Nog niet helemaal goed.</strong> Je kunt pas een onderwerp zoeken als je weet wat de persoonsvorm is.</p></qti-content-body>
    </qti-feedback-block>
    <qti-feedback-block identifier="UITLEG" outcome-identifier="FEEDBACK" show-hide="show" class="qti-feedback-incorrect">
      <qti-content-body><p><strong>Uitleg:</strong> Persoonsvorm → onderwerp → stam → t erachter? Bij <em>ik</em> en bij <em>jij/je</em> áchter de persoonsvorm komt er geen t.</p></qti-content-body>
    </qti-feedback-block>
  </qti-item-body>
  <qti-response-processing>
    <qti-response-condition>
      <qti-response-if>
        <qti-match><qti-variable identifier="RESPONSE" /><qti-correct identifier="RESPONSE" /></qti-match>
        <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">1</qti-base-value></qti-set-outcome-value>
      </qti-response-if>
    </qti-response-condition>
    <qti-response-condition>
      <qti-response-if>
        <qti-gte><qti-variable identifier="SCORE" /><qti-variable identifier="MAXSCORE" /></qti-gte>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">GOED</qti-base-value></qti-set-outcome-value>
      </qti-response-if>
      <qti-response-else-if>
        <qti-lte><qti-variable identifier="numAttempts" /><qti-base-value base-type="integer">1</qti-base-value></qti-lte>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">HINT</qti-base-value></qti-set-outcome-value>
      </qti-response-else-if>
      <qti-response-else>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">UITLEG</qti-base-value></qti-set-outcome-value>
      </qti-response-else>
    </qti-response-condition>
  </qti-response-processing>
</qti-assessment-item>
