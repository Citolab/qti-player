<?xml version="1.0" encoding="UTF-8"?>
<!--
  Adaptivity in the ITEM. One adaptive="true" item per step, in plain linear order; the test has no
  pre-conditions or branch rules. Inside each item the FASE outcome walks main question -> hulpvragen
  -> retry over several attempts and sets completionStatus = completed at the end. SCORE is 1 only
  when the main question was right straight away, so DIRECT means the same as in public/adaptief-toets.
  No tussenvragen and no "met / zonder begeleiding" choice in the intro: response processing only sees
  the item's own variables, so an item cannot read a choice made in another item. Choosing per learner
  which content to show needs the test.
-->
<qti-assessment-test xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
  identifier="adaptief-item" title="Adaptief binnen het item">
  <qti-outcome-declaration identifier="SCORE" base-type="float" cardinality="single">
    <qti-default-value><qti-value>0</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="MAXSCORE" base-type="float" cardinality="single">
    <qti-default-value><qti-value>0</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="PERCENTAGE" base-type="float" cardinality="single">
    <qti-default-value><qti-value>0</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="DIRECT" base-type="float" cardinality="single">
    <qti-default-value><qti-value>0</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="FEEDBACK" base-type="identifier" cardinality="single" />

  <qti-test-part identifier="LES" navigation-mode="linear" submission-mode="individual">
    <qti-item-session-control max-attempts="1" show-feedback="true" />
    <qti-assessment-section identifier="SOM" title="Eén som in vier stappen" visible="true">
      <qti-rubric-block use="instructions" view="candidate" class="qti-rubric-discretionary-placement">
        <qti-content-body>
          <p><strong>De som:</strong> <math xmlns="http://www.w3.org/1998/Math/MathML"><mfrac><mn>2</mn><mn>3</mn></mfrac></math> + <math xmlns="http://www.w3.org/1998/Math/MathML"><mfrac><mn>1</mn><mn>6</mn></mfrac></math> = ?</p>
          <p>Fien verft <math xmlns="http://www.w3.org/1998/Math/MathML"><mfrac><mn>2</mn><mn>3</mn></mfrac></math> van het tuinhek, haar buurjongen Mo verft <math xmlns="http://www.w3.org/1998/Math/MathML"><mfrac><mn>1</mn><mn>6</mn></mfrac></math>. Welk deel van het hek is samen geverfd?</p>
        </qti-content-body>
      </qti-rubric-block>
      <qti-assessment-item-ref identifier="INTRO" href="INTRO.xml" category="unscored">
        <qti-item-session-control max-attempts="1" show-feedback="true" allow-skipping="false" />
      </qti-assessment-item-ref>
      <qti-assessment-item-ref identifier="TELLER" href="TELLER.xml">
        <qti-item-session-control max-attempts="0" show-feedback="true" />
      </qti-assessment-item-ref>
      <qti-assessment-item-ref identifier="NOEMER" href="NOEMER.xml">
        <qti-item-session-control max-attempts="0" show-feedback="true" />
      </qti-assessment-item-ref>
      <qti-assessment-item-ref identifier="S1_ADAPTIEF" href="S1_ADAPTIEF.xml" />
      <qti-assessment-item-ref identifier="S2_ADAPTIEF" href="S2_ADAPTIEF.xml" />
      <qti-assessment-item-ref identifier="S3_ADAPTIEF" href="S3_ADAPTIEF.xml" />
      <qti-assessment-item-ref identifier="S4_ADAPTIEF" href="S4_ADAPTIEF.xml" />
    </qti-assessment-section>
  </qti-test-part>

  <qti-outcome-processing>
    <qti-set-outcome-value identifier="SCORE">
      <qti-sum><qti-test-variables variable-identifier="SCORE" /></qti-sum>
    </qti-set-outcome-value>
    <qti-set-outcome-value identifier="MAXSCORE">
      <!-- every scored item is worth 1 point: count the items this candidate was shown, so items a branch rule
           or pre-condition passed over do not count against them (the intro is not scored) -->
      <qti-number-presented exclude-category="unscored" />
    </qti-set-outcome-value>
    <qti-set-outcome-value identifier="PERCENTAGE">
      <qti-product>
        <qti-divide><qti-variable identifier="SCORE" /><qti-variable identifier="MAXSCORE" /></qti-divide>
        <qti-base-value base-type="float">100</qti-base-value>
      </qti-product>
    </qti-set-outcome-value>
    <!-- steps solved straight away, read from the item sessions with the item prefix -->
    <qti-set-outcome-value identifier="DIRECT">
      <qti-sum><qti-variable identifier="S1_ADAPTIEF.SCORE" /><qti-variable identifier="S2_ADAPTIEF.SCORE" /><qti-variable identifier="S3_ADAPTIEF.SCORE" /><qti-variable identifier="S4_ADAPTIEF.SCORE" /></qti-sum>
    </qti-set-outcome-value>
    <qti-outcome-condition>
      <qti-outcome-if>
        <qti-gte><qti-variable identifier="DIRECT" /><qti-base-value base-type="float">4</qti-base-value></qti-gte>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">ZELFSTANDIG</qti-base-value></qti-set-outcome-value>
      </qti-outcome-if>
      <qti-outcome-else-if>
        <qti-gte><qti-variable identifier="DIRECT" /><qti-base-value base-type="float">2</qti-base-value></qti-gte>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">OP_WEG</qti-base-value></qti-set-outcome-value>
      </qti-outcome-else-if>
      <qti-outcome-else>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">BEGELEIDING</qti-base-value></qti-set-outcome-value>
      </qti-outcome-else>
    </qti-outcome-condition>
  </qti-outcome-processing>

  <qti-test-feedback identifier="ZELFSTANDIG" outcome-identifier="FEEDBACK" show-hide="show" access="atEnd">
    <qti-content-body>Knap: elke stap was meteen goed. Breuken met verschillende noemers optellen lukt je al zelfstandig.</qti-content-body>
  </qti-test-feedback>
  <qti-test-feedback identifier="OP_WEG" outcome-identifier="FEEDBACK" show-hide="show" access="atEnd">
    <qti-content-body>Een paar stappen waren meteen goed, bij de andere hielpen de hulpvragen. Oefen die stappen nog eens met stroken.</qti-content-body>
  </qti-test-feedback>
  <qti-test-feedback identifier="BEGELEIDING" outcome-identifier="FEEDBACK" show-hide="show" access="atEnd">
    <qti-content-body>De meeste stappen lukten nog niet meteen. Geen probleem: met stroken en tekeningen oefen je verder, dan wordt het steeds makkelijker.</qti-content-body>
  </qti-test-feedback>
</qti-assessment-test>
