<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd" identifier="ITEM013" title="Benoem de delen van de plant" adaptive="false" time-dependent="false" xml:lang="nl-NL">
  <qti-response-declaration identifier="RESPONSE" cardinality="multiple" base-type="directedPair">
    <qti-correct-response><qti-value>BLAD HBLAD</qti-value><qti-value>STENGEL HSTENGEL</qti-value><qti-value>WORTEL HWORTEL</qti-value><qti-value>BLOEM HBLOEM</qti-value></qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" base-type="float" cardinality="single">
    <qti-default-value><qti-value>0</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="MAXSCORE" base-type="float" cardinality="single">
    <qti-default-value><qti-value>1</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="FEEDBACK" base-type="identifier" cardinality="single" />
  <qti-item-body>
    <qti-graphic-gap-match-interaction response-identifier="RESPONSE" max-associations="4">
      <qti-prompt><p>Benoem de delen van de plant.</p><p><em>Sleep elk woord naar het juiste deel van de plant. Eén woord blijft over.</em></p></qti-prompt>
      <img src="resources/plant.svg" width="800" height="600" alt="Een plant in de zon met een bloem, een stengel, twee bladeren en wortels in de grond." />
      <qti-gap-text identifier="WORTEL" match-max="1">wortel</qti-gap-text>
      <qti-gap-text identifier="BLOEM" match-max="1">bloem</qti-gap-text>
      <qti-gap-text identifier="ZAAD" match-max="1">zaad</qti-gap-text>
      <qti-gap-text identifier="BLAD" match-max="1">blad</qti-gap-text>
      <qti-gap-text identifier="STENGEL" match-max="1">stengel</qti-gap-text>
      <qti-associable-hotspot identifier="HBLOEM" shape="rect" coords="340,128,460,172" match-max="1" />
      <qti-associable-hotspot identifier="HBLAD" shape="rect" coords="485,233,605,277" match-max="1" />
      <qti-associable-hotspot identifier="HSTENGEL" shape="rect" coords="340,378,460,422" match-max="1" />
      <qti-associable-hotspot identifier="HWORTEL" shape="rect" coords="340,490,460,534" match-max="1" />
    </qti-graphic-gap-match-interaction>
    <qti-feedback-block identifier="GOED" outcome-identifier="FEEDBACK" show-hide="show" class="qti-feedback-correct">
      <qti-content-body><p><strong>Goed zo!</strong> Bloem bovenaan, blad opzij, stengel in het midden en wortels in de grond.</p></qti-content-body>
    </qti-feedback-block>
    <qti-feedback-block identifier="UITLEG" outcome-identifier="FEEDBACK" show-hide="show" class="qti-feedback-incorrect">
      <qti-content-body><p><strong>Uitleg:</strong> De bloem zit bovenaan, het blad (waar de fotosynthese gebeurt) zit aan de stengel, de stengel brengt water omhoog en de wortels zitten in de grond. Het woord <em>zaad</em> hoort er niet bij.</p></qti-content-body>
    </qti-feedback-block>
  </qti-item-body>
  <qti-response-processing>
    <qti-response-condition>
      <qti-response-if>
        <qti-match><qti-variable identifier="RESPONSE" /><qti-correct identifier="RESPONSE" /></qti-match>
        <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">1</qti-base-value></qti-set-outcome-value>
      </qti-response-if>
      <qti-response-else>
        <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">0</qti-base-value></qti-set-outcome-value>
      </qti-response-else>
    </qti-response-condition>
    <qti-response-condition>
      <qti-response-if>
        <qti-gte><qti-variable identifier="SCORE" /><qti-variable identifier="MAXSCORE" /></qti-gte>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">GOED</qti-base-value></qti-set-outcome-value>
      </qti-response-if>
      <qti-response-else>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">UITLEG</qti-base-value></qti-set-outcome-value>
      </qti-response-else>
    </qti-response-condition>
  </qti-response-processing>
</qti-assessment-item>
